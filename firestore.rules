rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vendors — public read, owner write
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == vendorId;

      match /packages/{pkgId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == vendorId;
      }
      match /products/{prodId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == vendorId;
      }
      match /pricing_rules/{ruleId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == vendorId;
      }
    }

    // Users — owner read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Events — any authenticated user can read (app filters by userId client-side)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Leads — vendor or client
    match /leads/{leadId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.vendor_id ||
         request.auth.uid == resource.data.client_id);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.vendor_id ||
         request.auth.uid == resource.data.client_id);

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Orders — authenticated users
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Reviews — public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
